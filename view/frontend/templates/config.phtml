<?php
/**
 * The configuration is emitted as a JSON data block rather than an executable inline script.
 *
 * A non-executable script type is data, so script-src never applies to it: there is no
 * per-request CSP nonce that can go stale when the markup is cached, and no content hash for a
 * merchant to whitelist. Amazon_Pay/js/model/amazon-pay-config reads it out of the DOM.
 *
 * @var \Amazon\Pay\Block\Config $block
 */
?>
<?php if ($block->isEnabled()): ?>
    <script type="application/json" id="amazon-pay-config"><?= /* @noEscape */ $block->getJsonConfig() ?></script>

    <?php if ($block->shouldClearCheckoutSession()): ?>
        <script type="text/x-magento-init">
        {
            "*": {
                "Amazon_Pay/js/clear-checkout-session": {}
            }
        }
        </script>
    <?php endif; ?>
<?php endif ?>
